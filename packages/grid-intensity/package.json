{
  "name": "@cloud-carbon-footprint/grid-intensity",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Grid carbon intensity source layer: pluggable sources, capability negotiation, licence declarations and provenance for Cloud Carbon Footprint estimates.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "main": "dist/index.js"
  },
  "homepage": "https://www.cloudcarbonfootprint.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bendemora/cloud-carbon-footprint.git",
    "directory": "packages/grid-intensity"
  },
  "keywords": [
    "cloud",
    "sustainability",
    "climate",
    "carbon-emissions",
    "carbon-footprint",
    "grid-carbon-intensity"
  ],
  "scripts": {
    "precommit": "lint-staged --no-stash && yarn test --coverage --runInBand --bail",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "test:watch": "yarn test --coverage --watchAll",
    "build": "rimraf dist && yarn build:tsc && yarn prepack && cp package.json dist && yarn postpack",
    "build:workspace": "mkdir -p ../../dist-workspace/packages/grid-intensity/dist && cp -R dist ../../dist-workspace/packages/grid-intensity && mv ../../dist-workspace/packages/grid-intensity/dist/package.json ../../dist-workspace/packages/grid-intensity",
    "build:update": "node ../../scripts/update-package-dependencies.js grid-intensity common",
    "prepack": "ts-node ../../scripts/prepack.ts",
    "postpack": "ts-node ../../scripts/postpack.ts",
    "build:tsc": "tsc --build tsconfig.json",
    "view:coverage": "serve coverage/lcov-report",
    "clean": "rimraf dist && rimraf coverage && rimraf logs",
    "lint": "eslint '*/**/*.ts' --quiet",
    "lint:fix": "eslint '*/**/*.ts' --quiet --fix"
  },
  "dependencies": {
    "@cloud-carbon-footprint/common": "^2.0.0",
    "mongodb": "^4.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "yarn lint",
      "prettier --write --ignore-unknown --config ../../.prettierrc.json"
    ],
    "*.{md}": [
      "prettier --write --ignore-unknown --config ../../.prettierrc.json"
    ]
  }
}
